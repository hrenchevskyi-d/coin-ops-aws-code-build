apiVersion: v1
kind: ServiceAccount
metadata:
  name: {{ headlamp_admin_service_account }}
  namespace: {{ headlamp_namespace }}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: {{ headlamp_admin_service_account }}
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: {{ headlamp_admin_cluster_role }}
subjects:
  - kind: ServiceAccount
    name: {{ headlamp_admin_service_account }}
    namespace: {{ headlamp_namespace }}
