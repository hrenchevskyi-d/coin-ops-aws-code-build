apiVersion: cert-manager.io/v1
kind: ClusterIssuer
metadata:
  name: {{ headlamp_cluster_issuer_name }}
spec:
  acme:
    email: {{ certbot_email }}
    server: {{ headlamp_acme_directory_url }}
    privateKeySecretRef:
      name: {{ headlamp_cluster_issuer_name }}-account-key
    solvers:
      - dns01:
          cloudflare:
            apiTokenSecretRef:
              name: {{ cert_manager_cloudflare_secret_name }}
              key: api-token
