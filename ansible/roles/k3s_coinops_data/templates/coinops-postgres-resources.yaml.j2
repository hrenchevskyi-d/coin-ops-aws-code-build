# Registry credentials come from the selected cloud secret backend.
apiVersion: v1
kind: Secret
metadata:
  name: {{ k3s_coinops_data_registry_pull_secret_name }}
  namespace: {{ k3s_coinops_data_namespace }}
type: kubernetes.io/dockerconfigjson
data:
  .dockerconfigjson: "{{ {'auths': {image_registry_host: {'username': registry_username, 'password': registry_token, 'auth': ((registry_username ~ ':' ~ registry_token) | b64encode)}}} | to_json | b64encode }}"
---
apiVersion: v1
kind: Secret
metadata:
  name: {{ k3s_coinops_data_superuser_secret_name }}
  namespace: {{ k3s_coinops_data_namespace }}
type: kubernetes.io/basic-auth
stringData:
  username: postgres
  password: "{{ db_password }}"
---
apiVersion: v1
kind: Secret
metadata:
  name: {{ k3s_coinops_data_app_secret_name }}
  namespace: {{ k3s_coinops_data_namespace }}
type: kubernetes.io/basic-auth
stringData:
  username: "{{ k3s_coinops_data_app_user }}"
  password: "{{ db_password }}"
{% if k3s_coinops_data_backup_enabled | bool %}
---
apiVersion: v1
kind: Secret
metadata:
  name: {{ k3s_coinops_data_backup_credentials_secret_name }}
  namespace: {{ k3s_coinops_data_namespace }}
  labels:
    cnpg.io/reload: "true"
type: Opaque
stringData:
{% if k3s_coinops_data_backup_provider == "s3" %}
  {{ k3s_coinops_data_backup_s3_access_key_id_secret_key }}: "{{ cnpg_backup_s3_access_key_id }}"
  {{ k3s_coinops_data_backup_s3_secret_access_key_secret_key }}: "{{ cnpg_backup_s3_secret_access_key }}"
{% else %}
  {{ k3s_coinops_data_backup_credentials_secret_key }}: |
{{ (cnpg_backup_gcs_credentials if cnpg_backup_gcs_credentials is string else (cnpg_backup_gcs_credentials | to_json)) | indent(4, true) }}
{% endif %}
{% endif %}
---
# Runtime SQL is mounted into the one-shot bootstrap job.
apiVersion: v1
kind: ConfigMap
metadata:
  name: {{ k3s_coinops_data_runtime_configmap_name }}
  namespace: {{ k3s_coinops_data_namespace }}
data:
{% for filename in k3s_coinops_data_runtime_sql_files %}
  {{ filename }}: |
{{ lookup('file', repo_root ~ '/deploy/sql/runtime/' ~ filename) | indent(4, true) }}
{% endfor %}
---
# CNPG creates the primary database and owner; the follow-up bootstrap job adds
# extensions/functions that initdb cannot express cleanly.
apiVersion: postgresql.cnpg.io/v1
kind: Cluster
metadata:
  name: {{ k3s_coinops_data_cluster_name }}
  namespace: {{ k3s_coinops_data_namespace }}
spec:
  instances: {{ k3s_coinops_data_instances }}
  enableSuperuserAccess: true
  imageName: {{ k3s_coinops_data_postgres_image }}
  postgresUID: {{ k3s_coinops_data_postgres_uid }}
  postgresGID: {{ k3s_coinops_data_postgres_gid }}
  imagePullSecrets:
    - name: {{ k3s_coinops_data_registry_pull_secret_name }}
{% if k3s_coinops_data_backup_enabled | bool %}
  plugins:
    - name: {{ k3s_coinops_data_barman_plugin_name }}
      isWALArchiver: true
      parameters:
        barmanObjectName: {{ k3s_coinops_data_backup_objectstore_name }}
{% endif %}
  topologySpreadConstraints:
    - maxSkew: 1
      topologyKey: kubernetes.io/hostname
      whenUnsatisfiable: DoNotSchedule
      labelSelector:
        matchLabels:
          cnpg.io/cluster: {{ k3s_coinops_data_cluster_name }}
  superuserSecret:
    name: {{ k3s_coinops_data_superuser_secret_name }}
  bootstrap:
    initdb:
      database: {{ k3s_coinops_data_database_name }}
      owner: {{ k3s_coinops_data_app_user }}
      secret:
        name: {{ k3s_coinops_data_app_secret_name }}
  storage:
    size: {{ k3s_coinops_data_storage_size }}
  postgresql:
    shared_preload_libraries:
      - pg_cron
    parameters:
      cron.database_name: "{{ k3s_coinops_data_database_name }}"

{% if k3s_coinops_data_backup_enabled | bool %}
---
apiVersion: barmancloud.cnpg.io/v1
kind: ObjectStore
metadata:
  name: {{ k3s_coinops_data_backup_objectstore_name }}
  namespace: {{ k3s_coinops_data_namespace }}
spec:
  retentionPolicy: {{ k3s_coinops_data_backup_retention_policy | quote }}
  configuration:
    destinationPath: {{ k3s_coinops_data_backup_destination_path | quote }}
{% if k3s_coinops_data_backup_provider == "s3" %}
    s3Credentials:
      accessKeyId:
        name: {{ k3s_coinops_data_backup_credentials_secret_name }}
        key: {{ k3s_coinops_data_backup_s3_access_key_id_secret_key }}
      secretAccessKey:
        name: {{ k3s_coinops_data_backup_credentials_secret_name }}
        key: {{ k3s_coinops_data_backup_s3_secret_access_key_secret_key }}
{% else %}
    googleCredentials:
      applicationCredentials:
        name: {{ k3s_coinops_data_backup_credentials_secret_name }}
        key: {{ k3s_coinops_data_backup_credentials_secret_key }}
{% endif %}
    wal:
      compression: gzip
    data:
      compression: gzip
---
apiVersion: postgresql.cnpg.io/v1
kind: ScheduledBackup
metadata:
  name: {{ k3s_coinops_data_backup_scheduled_name }}
  namespace: {{ k3s_coinops_data_namespace }}
spec:
  cluster:
    name: {{ k3s_coinops_data_cluster_name }}
  schedule: {{ k3s_coinops_data_backup_schedule | quote }}
  backupOwnerReference: self
  method: plugin
  pluginConfiguration:
    name: {{ k3s_coinops_data_barman_plugin_name }}
{% endif %}

---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: coinops-data-default-deny
  namespace: {{ k3s_coinops_data_namespace }}
spec:
  podSelector: {}
  policyTypes:
    - Ingress
    - Egress
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: coinops-data-allowed-egress
  namespace: {{ k3s_coinops_data_namespace }}
spec:
  podSelector: {}
  policyTypes:
    - Egress
  egress:
    - to:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: kube-system
      ports:
        - protocol: UDP
          port: 53
        - protocol: TCP
          port: 53
    - to:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: {{ k3s_coinops_data_namespace }}
      ports:
        - protocol: TCP
          port: 5432
    - to:
        - ipBlock:
            cidr: {{ k3s_coinops_data_kubernetes_api_service_cidr }}
      ports:
        - protocol: TCP
          port: 443
    - to:
        - ipBlock:
            cidr: {{ k3s_coinops_data_kubernetes_api_endpoint_cidr }}
      ports:
        - protocol: TCP
          port: 6443
    - to:
        - ipBlock:
            cidr: 0.0.0.0/0
      ports:
        - protocol: TCP
          port: 443
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: coinops-postgres-allowed-ingress
  namespace: {{ k3s_coinops_data_namespace }}
spec:
  podSelector:
    matchLabels:
      cnpg.io/cluster: {{ k3s_coinops_data_cluster_name }}
  policyTypes:
    - Ingress
  ingress:
    - from:
        - podSelector: {}
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: coinops-proxy
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: coinops-history-api
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: coinops-history-consumer
      ports:
        - protocol: TCP
          port: 5432
    - from:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: {{ k3s_coinops_data_cnpg_namespace }}
      ports:
        - protocol: TCP
          port: 8000
