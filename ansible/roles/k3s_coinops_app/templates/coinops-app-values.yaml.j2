# Ansible creates Secrets before Helm runs; values keep only references.
runtimeBackend: {{ k3s_coinops_app_runtime_backend | to_json }}
imagePullSecretName: {{ k3s_coinops_app_registry_pull_secret_name | to_json }}
secret:
  name: {{ k3s_coinops_app_database_secret_name | to_json }}
networkPolicy:
  uiNamespace: {{ k3s_coinops_app_ui_namespace | to_json }}
  dataNamespace: {{ k3s_coinops_app_data_namespace | to_json }}
proxy:
  namespace: {{ k3s_coinops_app_proxy_namespace | to_json }}
  name: {{ k3s_coinops_app_proxy_name | to_json }}
  serviceAccountName: "coinops-proxy"
  image: {{ k3s_coinops_app_proxy_image | to_json }}
  servicePort: {{ k3s_coinops_app_proxy_service_port }}
  replicas: {{ k3s_coinops_app_proxy_replicas }}
  podSecurityContext:
    runAsNonRoot: true
    runAsUser: {{ k3s_coinops_app_proxy_run_as_user }}
    runAsGroup: {{ k3s_coinops_app_run_as_group }}
    fsGroup: {{ k3s_coinops_app_run_as_group }}
    seccompProfile:
      type: RuntimeDefault
  securityContext:
    allowPrivilegeEscalation: false
    readOnlyRootFilesystem: true
    capabilities:
      drop:
        - ALL
  autoscaling:
    enabled: {{ k3s_coinops_app_autoscaling_enabled | bool | to_json }}
    minReplicas: {{ k3s_coinops_app_autoscaling_min_replicas }}
    maxReplicas: {{ k3s_coinops_app_autoscaling_max_replicas }}
    targetCPUUtilizationPercentage: {{ k3s_coinops_app_autoscaling_target_cpu_utilization }}
  podDisruptionBudget:
    enabled: {{ k3s_coinops_app_pdb_enabled | bool | to_json }}
    minAvailable: {{ k3s_coinops_app_pdb_min_available }}
  resources:
{{ k3s_coinops_app_proxy_resources | to_nice_yaml(indent=2) | indent(4, true) }}
historyApi:
  namespace: {{ k3s_coinops_app_history_api_namespace | to_json }}
  name: {{ k3s_coinops_app_history_api_name | to_json }}
  serviceAccountName: "coinops-history-api"
  image: {{ k3s_coinops_app_history_api_image | to_json }}
  servicePort: {{ k3s_coinops_app_history_api_service_port }}
  replicas: {{ k3s_coinops_app_history_api_replicas }}
  podSecurityContext:
    runAsNonRoot: true
    runAsUser: {{ k3s_coinops_app_history_api_run_as_user }}
    runAsGroup: {{ k3s_coinops_app_run_as_group }}
    fsGroup: {{ k3s_coinops_app_run_as_group }}
    seccompProfile:
      type: RuntimeDefault
  securityContext:
    allowPrivilegeEscalation: false
    readOnlyRootFilesystem: true
    capabilities:
      drop:
        - ALL
  autoscaling:
    enabled: {{ k3s_coinops_app_autoscaling_enabled | bool | to_json }}
    minReplicas: {{ k3s_coinops_app_autoscaling_min_replicas }}
    maxReplicas: {{ k3s_coinops_app_autoscaling_max_replicas }}
    targetCPUUtilizationPercentage: {{ k3s_coinops_app_autoscaling_target_cpu_utilization }}
  podDisruptionBudget:
    enabled: {{ k3s_coinops_app_pdb_enabled | bool | to_json }}
    minAvailable: {{ k3s_coinops_app_pdb_min_available }}
  resources:
{{ k3s_coinops_app_history_api_resources | to_nice_yaml(indent=2) | indent(4, true) }}
consumer:
  namespace: {{ k3s_coinops_app_consumer_namespace | to_json }}
  name: {{ k3s_coinops_app_consumer_name | to_json }}
  serviceAccountName: "coinops-history-consumer"
  image: {{ k3s_coinops_app_consumer_image | to_json }}
  replicas: {{ k3s_coinops_app_consumer_replicas }}
  podSecurityContext:
    runAsNonRoot: true
    runAsUser: {{ k3s_coinops_app_consumer_run_as_user }}
    runAsGroup: {{ k3s_coinops_app_run_as_group }}
    fsGroup: {{ k3s_coinops_app_run_as_group }}
    seccompProfile:
      type: RuntimeDefault
  securityContext:
    allowPrivilegeEscalation: false
    readOnlyRootFilesystem: true
    capabilities:
      drop:
        - ALL
  autoscaling:
    enabled: {{ k3s_coinops_app_autoscaling_enabled | bool | to_json }}
    minReplicas: {{ k3s_coinops_app_autoscaling_min_replicas }}
    maxReplicas: {{ k3s_coinops_app_autoscaling_max_replicas }}
    targetCPUUtilizationPercentage: {{ k3s_coinops_app_autoscaling_target_cpu_utilization }}
  podDisruptionBudget:
    enabled: {{ k3s_coinops_app_pdb_enabled | bool | to_json }}
    minAvailable: {{ k3s_coinops_app_pdb_min_available }}
  resources:
{{ k3s_coinops_app_consumer_resources | to_nice_yaml(indent=2) | indent(4, true) }}
