# Applied by Ansible with no_log; do not pass registry credentials through Helm values.
apiVersion: v1
kind: Secret
metadata:
  name: {{ k3s_coinops_ui_registry_pull_secret_name }}
  namespace: {{ k3s_coinops_ui_namespace }}
type: kubernetes.io/dockerconfigjson
data:
  .dockerconfigjson: {{ {'auths': {image_registry_host: {'username': registry_username, 'password': registry_token, 'auth': ((registry_username ~ ':' ~ registry_token) | b64encode)}}} | to_json | b64encode | to_json }}
