{%- set kubeconfig = k3s_kubeconfig_raw.content | b64decode | from_yaml -%}
{%- set cluster = kubeconfig.clusters[0] -%}
{%- set rewritten_cluster = cluster | combine({
  'cluster': cluster.cluster | combine({
    'server': 'https://127.0.0.1:6443',
    'tls-server-name': k3s_operator_api_endpoint
  })
}, recursive=True) -%}
{{ kubeconfig | combine({'clusters': [rewritten_cluster]}, recursive=True) | to_nice_yaml(indent=2, sort_keys=false) }}
