service:
  spec:
    type: NodePort
ports:
  web:
    port: 8000
    exposedPort: 80
    nodePort: {{ public_ingress_http_nodeport | int }}
  websecure:
    port: 8443
    exposedPort: 443
    nodePort: {{ public_ingress_https_nodeport | int }}
providers:
  kubernetesIngress:
    ingressClass: {{ public_ingress_class_name | to_json }}
ingressClass:
  enabled: true
  isDefaultClass: false
  name: {{ public_ingress_class_name | to_json }}
