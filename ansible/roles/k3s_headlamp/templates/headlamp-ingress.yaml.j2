apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: {{ headlamp_release_name }}
  namespace: {{ headlamp_namespace }}
spec:
  ingressClassName: {{ headlamp_ingress_class_name }}
{% if headlamp_tls_enabled | bool %}
  tls:
    - hosts:
        - {{ headlamp_ingress_host }}
      secretName: {{ headlamp_tls_secret_name }}
{% endif %}
  rules:
    - host: {{ headlamp_ingress_host }}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: {{ headlamp_release_name }}
                port:
                  number: {{ headlamp_service_port }}
