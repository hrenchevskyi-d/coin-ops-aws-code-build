{
    "routing": {},
    "security": {
        "egress_cidrs": [
            "0.0.0.0/0"
        ]
    },
    "cloud_networks": {
        "gcp": {
            "vpc_name": "coin-ops-gcp-vpc",
            "vpc_cidr": "10.20.0.0/16",
            "cloud_nat": {
                "enabled": true,
                "subnet_names": [
                    "internal"
                ]
            },
            "k3s_api_load_balancer": {
                "enabled": true,
                "name": "coin-ops-k3s-api",
                "port": 6443,
                "internal_subnet": "internal",
                "allow_global_access": false
            },
            "k3s_ingress_load_balancer": {
                "enabled": false,
                "name": "coin-ops-k3s-ingress",
                "ports": [
                    80,
                    443
                ],
                "health_check_port": 80,
                "address": "10.20.1.77",
                "internal_subnet": "internal",
                "allow_global_access": false
            },
            "k3s_public_ingress_load_balancer": {
                "enabled": true,
                "name": "coin-ops-k3s-public-ingress",
                "health_check_port": 443,
                "frontend_ports": [
                    443
                ]
            },
            "subnets": {
                "internal": {
                    "cidr": "10.20.1.0/24",
                    "availability_zone_key": "primary"
                },
                "database": {
                    "cidr": "10.20.3.0/24",
                    "availability_zone_key": "secondary"
                },
                "external": {
                    "cidr": "10.20.2.0/24",
                    "public": true
                }
            }
        },
        "aws": {
            "vpc_name": "coin-ops-aws-vpc",
            "vpc_cidr": "10.30.0.0/16",
            "subnets": {
                "internal": {
                    "cidr": "10.30.1.0/24",
                    "availability_zone_key": "primary"
                },
                "database": {
                    "cidr": "10.30.3.0/24",
                    "availability_zone_key": "secondary"
                },
                "external": {
                    "cidr": "10.30.2.0/24",
                    "public": true
                }
            }
        },
        "azure": {
            "vpc_name": "coin-ops-azure-vpc",
            "vpc_cidr": "10.40.0.0/16",
            "subnets": {
                "internal": {
                    "cidr": "10.40.1.0/24",
                    "availability_zone_key": "primary"
                },
                "database": {
                    "cidr": "10.40.3.0/24",
                    "availability_zone_key": "secondary"
                },
                "external": {
                    "cidr": "10.40.2.0/24",
                    "public": true
                }
            }
        }
    },
    "tailscale": {
        "enabled": false,
        "control_plane": "saas",
        "auth_key_secret_name": "TAILSCALE_AUTH_KEY",
        "accept_routes": false,
        "snat_subnet_routes": false,
        "client_cidrs": [
            "100.64.0.0/10"
        ],
        "static_route_roles": [],
        "tags": {
            "gateway": [
                "tag:coinops-gateway"
            ]
        },
        "advertised_routes_per_cloud": {}
    },
    "firewall_rules": {
        "allow-ssh-jump-host": {
            "protocols": [
                {
                    "protocol": "tcp",
                    "ports": [
                        "53725"
                    ]
                }
            ],
            "source_cidrs": [
                "0.0.0.0/0"
            ],
            "target_role": "jump-host"
        },
        "allow-k3s-server-admin-from-jump": {
            "protocols": [
                {
                    "protocol": "tcp",
                    "ports": [
                        "53725"
                    ]
                }
            ],
            "source_role": "jump-host",
            "target_role": "k3s-server"
        },
        "allow-k3s-control-plane-internal": {
            "protocols": [
                {
                    "protocol": "tcp",
                    "ports": [
                        "6443",
                        "9345",
                        "2379-2380",
                        "10250"
                    ]
                },
                {
                    "protocol": "udp",
                    "ports": [
                        "8472"
                    ]
                },
                {
                    "protocol": "icmp"
                }
            ],
            "source_cidrs": [
                "10.20.0.0/16"
            ],
            "target_role": "k3s-server"
        },
        "allow-k3s-public-ingress-https": {
            "protocols": [
                {
                    "protocol": "tcp",
                    "ports": [
                        "443"
                    ]
                }
            ],
            "source_cidrs": [
                "0.0.0.0/0"
            ],
            "target_role": "k3s-server"
        },
        "allow-k3s-api-lb-health-checks": {
            "protocols": [
                {
                    "protocol": "tcp",
                    "ports": [
                        "6443"
                    ]
                }
            ],
            "source_cidrs": [
                "35.191.0.0/16",
                "130.211.0.0/22"
            ],
            "target_role": "k3s-server"
        },
        "allow-k3s-public-ingress-lb-health-checks": {
            "protocols": [
                {
                    "protocol": "tcp",
                    "ports": [
                        "443"
                    ]
                }
            ],
            "source_cidrs": [
                "35.191.0.0/16",
                "130.211.0.0/22"
            ],
            "target_role": "k3s-server"
        }
    }
}
