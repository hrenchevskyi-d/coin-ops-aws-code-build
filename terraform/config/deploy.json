{
    "deploy": {
        "app_domain": "coinops-d.pp.ua",
        "tls_mode": "certbot",
        "tls": {
            "mode": "certbot",
            "certbot": {
                "email_localpart": "admin",
                "staging": false
            }
        },
        "certbot": {
            "email_localpart": "admin",
            "staging": false
        },
        "runtime_backend": "external",
        "kubernetes": {
            "runtime": "eks"
        },
        "eks": {
            "enabled": true,
            "cluster_name": "coin-ops-eks",
            "version": "1.33",
            "service_ipv4_cidr": "10.43.0.0/16",
            "endpoint_public": true,
            "endpoint_private": true,
            "public_access_cidrs": [
                "0.0.0.0/0"
            ],
            "private_subnets": [
                "internal",
                "private-b"
            ],
            "public_subnets": [
                "external",
                "public-b"
            ],
            "node_group": {
                "name": "system",
                "instance_types": [
                    "m7i-flex.large"
                ],
                "desired_size": 3,
                "min_size": 2,
                "max_size": 3,
                "disk_size": 30
            },
            "addons": {
                "vpc-cni": {
                    "enabled": true
                },
                "coredns": {
                    "enabled": true
                },
                "kube-proxy": {
                    "enabled": true
                },
                "aws-ebs-csi-driver": {
                    "enabled": true
                },
                "amazon-cloudwatch-observability": {
                    "enabled": true
                }
            }
        },
        "k3s": {
            "channel": "stable",
            "version": "v1.35.4+k3s1",
            "disable_cloud_controller": true,
            "disable_components": [
                "servicelb"
            ],
            "flannel_backend": "vxlan"
        },
        "public_ingress": {
            "enabled": true,
            "class_name": "traefik"
        },
        "headlamp": {
            "enabled": true,
            "hostname": "headlamp.coinops-d.pp.ua",
            "ingress": {
                "enabled": false,
                "class_name": "traefik"
            },
            "cloudflare_tunnel": {
                "enabled": true,
                "namespace": "cloudflare-tunnel",
                "release_name": "headlamp-tunnel",
                "replica_count": 2,
                "service": "http://headlamp.headlamp.svc.cluster.local:80",
                "chart_version": "",
                "access": {
                    "enabled": true,
                    "allowed_emails": ["grenchevskiyd@gmail.com"]
                }
            }
        },
        "jenkins": {
            "enabled": true,
            "hostname": "jenkins.coinops-d.pp.ua",
            "namespace": "jenkins",
            "release_name": "jenkins",
            "chart_version": "",
            "controller_tag": "2.555.3-jdk21",
            "public_url": "https://jenkins.coinops-d.pp.ua/",
            "storage_class": "gp2",
            "storage_size": "8Gi",
            "repository_url": "https://github.com/hrenchevskyi-d/coin-ops-aws-code-build.git",
            "branch": "hrenchevskyi-codebuild",
            "job_name": "coinops-eks-deploy",
            "locale": {
                "system_locale": "en",
                "ignore_accept_language": true,
                "allow_user_preferences": false
            },
            "theme": {
                "name": "dark",
                "disable_user_themes": true
            },
            "cloudflare_tunnel": {
                "enabled": true,
                "service": "http://jenkins.jenkins.svc.cluster.local:8080",
                "access": {
                    "enabled": true,
                    "allowed_emails": ["grenchevskiyd@gmail.com"]
                }
            }
        },
        "homepage": {
            "enabled": true,
            "hostname": "home.coinops-d.pp.ua",
            "ingress": {
                "enabled": true,
                "class_name": "traefik"
            }
        },
        "coinops": {
            "enabled": true,
            "hostname": "coinops-d.pp.ua",
            "runtime_backend": "postgres",
            "ingress": {
                "enabled": true,
                "class_name": "traefik"
            }
        },
        "ghcr_username": "hrenchevskyi-d",
        "internal_tls": {
            "enabled": true,
            "port": 8443
        }
    },
    "images": {
        "registry": "ghcr.io/ua-academy-projects",
        "tag": "dev-latest",
        "postgres_runtime_image": "ghcr.io/ua-academy-projects/coin-ops-postgres-runtime:16-dev-latest"
    },
    "ports": {
        "https": 443,
        "postgres": 5432,
        "rabbitmq": 5672,
        "rabbitmq_management": 15672,
        "proxy": 8080,
        "history": 8000
    },
    "ansible": {
        "provisioning": {
            "wait_for_connection_timeout": 600,
            "wait_for_connection_delay": 5,
            "wait_for_connection_sleep": 5,
            "wait_for_cloud_init": true,
            "apt_lock_timeout": 900,
            "become_timeout": 60,
            "host_batch_size": 4,
            "workload_batch_size": 4,
            "upgrade_packages": false
        }
    }
}
