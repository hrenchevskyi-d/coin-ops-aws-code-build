# Copy to .env only for local operator convenience. Bootstrap scripts usually
# generate local/generated-*.sh, which are preferred for normal Terraform and
# Ansible work.

# SSH key injected by Terraform and used by generated ssh_config.
export SSH_KEY_PATH=~/.ssh/coin-ops-key
export TF_VAR_ssh_public_key_path="${SSH_KEY_PATH}.pub"

# Optional cloud CLI/provider defaults. Canonical non-secret values live in
# terraform/config/*.json; these only help local CLIs authenticate.
export GOOGLE_APPLICATION_CREDENTIALS=$(pwd)/terraform/sa-key.json
export GOOGLE_CLOUD_PROJECT=your-gcp-project-id
export GCP_PROJECT=$GOOGLE_CLOUD_PROJECT
export GCP_SERVICE_ACCOUNT_FILE=$GOOGLE_APPLICATION_CREDENTIALS
export AWS_REGION=eu-central-1
export AZURE_SUBSCRIPTION_ID=your-subscription-id
export AZURE_TENANT_ID=your-tenant-id

# Ansible should use this repository's config file.
export ANSIBLE_CONFIG=$(pwd)/ansible.cfg

# Optional deployment overrides. Prefer terraform/config/deploy.json unless you
# need a one-off operator override.
export IMAGE_REGISTRY=ghcr.io/ua-academy-projects
export IMAGE_TAG=shabat-latest
export RUNTIME_BACKEND=postgres
export APP_DOMAIN=coinops.test
export TLS_MODE=selfsigned

# Required only when seeding cloud secret managers from local tfvars.
export TF_VAR_db_password=change_me
export TF_VAR_rabbitmq_password=change_me
export TF_VAR_ghcr_token=github_pat_change_me
export TF_VAR_cloudflare_api_token=change_me
export TF_VAR_tailscale_auth_key=tskey-auth-change_me
