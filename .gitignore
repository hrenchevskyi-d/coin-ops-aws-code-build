# Environment file — passwords and local paths, never commit
.env

# Worktrees created by agent runs
.claude/worktrees/
.worktrees/
.codex-*

# Superpowers generated plans/specs — internal tooling, not for the repo
docs/superpowers/

# Terraform
terraform/.terraform/
terraform/.terraform.codex-bak/
terraform/.terraform.lock.hcl
terraform/backend.active.tf
terraform/*.tfstate
terraform/*.tfstate.backup
terraform/terraform.tfstate.*.backup
terraform/plan.out
terraform/plan.txt
terraform/terraform.tfvars
terraform/local.generated.auto.tfvars.json
terraform/bootstrap.secrets.auto.tfvars
terraform/keys/

# hosts.json contains live infrastructure IPs — generated by terraform apply
terraform/config/hosts.json
terraform/config/ssh_config
terraform/config/ansible-runtime.json
ansible/vars/local.generated.json
ansible/artifacts/

# Patch files
*.patch

# Local TLS certificates/keys generated for mkcert demos
*.pem

# Python cache
__pycache__/
*.pyc
*.pyo

# Local docs and infrastructure artifacts
ansible/group_vars/all/*.backup
ansible/group_vars/all/secrets.yml
local/generated-env.sh
local/generated-gcp-env.sh
local/generated-aws-env.sh
local/generated-azure-env.sh
packer/**/*.pkrvars.hcl
packer/**/*.manifest.json
packer/packer_cache/

ssh_config
terraform/sa-key.json

.venv/*
local/generated-azure-python-env.sh
backups/*
