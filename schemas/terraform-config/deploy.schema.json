{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coin-ops.local/schemas/terraform-config/deploy.schema.json",
  "title": "Coin-Ops deployment settings",
  "description": "Application domains, TLS mode, k3s settings, ingress features, image defaults, ports, and Ansible provisioning defaults.",
  "type": "object",
  "required": ["deploy", "images", "ports", "ansible"],
  "additionalProperties": false,
  "properties": {
    "deploy": {
      "type": "object",
      "required": ["app_domain", "tls_mode", "runtime_backend", "k3s", "public_ingress", "headlamp", "jenkins", "homepage", "coinops", "ghcr_username", "internal_tls"],
      "additionalProperties": false,
      "properties": {
        "app_domain": { "type": "string", "minLength": 1, "description": "Root application domain." },
        "tls_mode": { "type": "string", "enum": ["certbot", "self-signed", "disabled"], "description": "Legacy top-level TLS mode retained for compatibility." },
        "tls": { "$ref": "#/$defs/tls", "description": "Structured TLS settings." },
        "certbot": { "$ref": "#/$defs/certbot", "description": "Legacy Certbot settings retained for compatibility." },
        "runtime_backend": { "type": "string", "enum": ["postgres", "external"], "description": "Runtime state backend mode. external is RabbitMQ/Redis rollback support only." },
        "kubernetes": { "$ref": "#/$defs/kubernetes", "description": "Kubernetes runtime selection for infrastructure-managed clusters." },
        "eks": { "$ref": "#/$defs/eks", "description": "AWS EKS managed Kubernetes settings." },
        "k3s": { "$ref": "#/$defs/k3s", "description": "k3s install and server configuration." },
        "public_ingress": { "$ref": "#/$defs/ingressFeature", "description": "Whether public ingress should be exposed." },
        "headlamp": { "$ref": "#/$defs/headlamp", "description": "Headlamp dashboard deployment and access settings." },
        "jenkins": { "$ref": "#/$defs/jenkins", "description": "Jenkins controller and seeded automation job settings." },
        "homepage": { "$ref": "#/$defs/namedIngressFeature", "description": "Homepage deployment and ingress settings." },
        "coinops": { "$ref": "#/$defs/coinops", "description": "Coin-Ops workload deployment and ingress settings." },
        "ghcr_username": { "type": "string", "minLength": 1, "description": "GitHub Container Registry username used for image pulls." },
        "internal_tls": { "$ref": "#/$defs/internalTls", "description": "Internal service TLS settings." },
        "cnpg_backup": { "$ref": "#/$defs/cnpgBackup", "description": "Optional CloudNativePG backup destination settings." }
      }
    },
    "images": {
      "type": "object",
      "required": ["registry", "tag", "postgres_runtime_image"],
      "additionalProperties": false,
      "properties": {
        "registry": { "type": "string", "minLength": 1, "description": "Default container image registry." },
        "tag": { "type": "string", "minLength": 1, "description": "Default application image tag." },
        "postgres_runtime_image": { "type": "string", "minLength": 1, "description": "PostgreSQL runtime image used by k3s data workloads." }
      }
    },
    "ports": {
      "type": "object",
      "required": ["https", "postgres", "rabbitmq", "rabbitmq_management", "proxy", "history"],
      "additionalProperties": false,
      "properties": {
        "https": { "$ref": "#/$defs/port", "description": "Public HTTPS port." },
        "postgres": { "$ref": "#/$defs/port", "description": "PostgreSQL port." },
        "rabbitmq": { "$ref": "#/$defs/port", "description": "RabbitMQ AMQP port." },
        "rabbitmq_management": { "$ref": "#/$defs/port", "description": "RabbitMQ management UI port." },
        "proxy": { "$ref": "#/$defs/port", "description": "Backend proxy service port." },
        "history": { "$ref": "#/$defs/port", "description": "History API service port." }
      }
    },
    "ansible": {
      "type": "object",
      "required": ["provisioning"],
      "additionalProperties": false,
      "properties": {
        "provisioning": {
          "type": "object",
          "required": ["wait_for_connection_timeout", "wait_for_connection_delay", "wait_for_connection_sleep", "wait_for_cloud_init", "apt_lock_timeout", "become_timeout", "host_batch_size", "workload_batch_size", "upgrade_packages"],
          "additionalProperties": false,
          "properties": {
            "wait_for_connection_timeout": { "type": "integer", "minimum": 1, "description": "Maximum seconds Ansible waits for SSH connectivity." },
            "wait_for_connection_delay": { "type": "integer", "minimum": 0, "description": "Initial delay before waiting for SSH." },
            "wait_for_connection_sleep": { "type": "integer", "minimum": 1, "description": "Sleep interval between SSH connectivity checks." },
            "wait_for_cloud_init": { "type": "boolean", "description": "Whether provisioning waits for cloud-init completion." },
            "apt_lock_timeout": { "type": "integer", "minimum": 1, "description": "APT lock wait timeout in seconds." },
            "become_timeout": { "type": "integer", "minimum": 1, "description": "Privilege escalation timeout in seconds." },
            "host_batch_size": { "type": "integer", "minimum": 1, "description": "Maximum host batch size for provisioning." },
            "workload_batch_size": { "type": "integer", "minimum": 1, "description": "Maximum host batch size for workload deployment." },
            "upgrade_packages": { "type": "boolean", "description": "Whether provisioning upgrades OS packages." }
          }
        }
      }
    }
  },
  "$defs": {
    "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "certbot": {
      "type": "object",
      "required": ["email_localpart", "staging"],
      "additionalProperties": false,
      "properties": {
        "email_localpart": { "type": "string", "minLength": 1, "description": "Local part used to build the Certbot contact email." },
        "staging": { "type": "boolean", "description": "Whether to use Let's Encrypt staging." }
      }
    },
    "tls": {
      "type": "object",
      "required": ["mode", "certbot"],
      "additionalProperties": false,
      "properties": {
        "mode": { "type": "string", "enum": ["certbot", "self-signed", "disabled"], "description": "TLS provisioning mode." },
        "certbot": { "$ref": "#/$defs/certbot" }
      }
    },
    "k3s": {
      "type": "object",
      "required": ["channel", "version", "disable_cloud_controller", "disable_components", "flannel_backend"],
      "additionalProperties": false,
      "properties": {
        "channel": { "type": "string", "minLength": 1, "description": "k3s release channel." },
        "version": { "type": "string", "minLength": 1, "description": "Pinned k3s version." },
        "disable_cloud_controller": { "type": "boolean", "description": "Whether to disable the built-in cloud controller." },
        "disable_components": {
          "type": "array",
          "description": "Built-in k3s components to disable.",
          "items": { "type": "string", "minLength": 1 }
        },
        "flannel_backend": { "type": "string", "minLength": 1, "description": "Flannel backend used by k3s." }
      }
    },
    "kubernetes": {
      "type": "object",
      "required": ["runtime"],
      "additionalProperties": false,
      "properties": {
        "runtime": {
          "type": "string",
          "enum": ["k3s", "eks"],
          "description": "Kubernetes runtime. k3s uses self-managed VM nodes; eks uses AWS managed Kubernetes."
        }
      }
    },
    "eks": {
      "type": "object",
      "required": ["enabled", "cluster_name", "version", "private_subnets", "public_subnets", "node_group", "addons"],
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "description": "Whether AWS EKS resources are managed when kubernetes.runtime is eks." },
        "cluster_name": { "type": "string", "minLength": 1, "description": "EKS cluster name." },
        "version": { "type": "string", "minLength": 1, "description": "Kubernetes version for EKS control plane." },
        "service_ipv4_cidr": {
          "type": "string",
          "minLength": 1,
          "description": "Kubernetes Service CIDR assigned by EKS at cluster creation."
        },
        "endpoint_public": {
          "type": "boolean",
          "description": "Whether the EKS Kubernetes API endpoint is reachable from the public internet."
        },
        "endpoint_private": {
          "type": "boolean",
          "description": "Whether the EKS Kubernetes API endpoint is reachable inside the VPC."
        },
        "public_access_cidrs": {
          "type": "array",
          "minItems": 1,
          "description": "CIDR ranges allowed to reach the public EKS Kubernetes API endpoint.",
          "items": { "type": "string", "minLength": 1 }
        },
        "private_subnets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "description": "Private subnet keys from networks.json used by EKS managed node groups.",
          "items": { "type": "string", "minLength": 1 }
        },
        "public_subnets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "description": "Public subnet keys from networks.json available for public AWS load balancers and NAT Gateway.",
          "items": { "type": "string", "minLength": 1 }
        },
        "node_group": {
          "type": "object",
          "required": ["name", "instance_types", "desired_size", "min_size", "max_size", "disk_size"],
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string", "minLength": 1, "description": "Managed node group name." },
            "instance_types": {
              "type": "array",
              "minItems": 1,
              "description": "EC2 instance types used by the managed node group.",
              "items": { "type": "string", "minLength": 1 }
            },
            "desired_size": { "type": "integer", "minimum": 0, "description": "Desired managed node group size." },
            "min_size": { "type": "integer", "minimum": 0, "description": "Minimum managed node group size." },
            "max_size": { "type": "integer", "minimum": 1, "description": "Maximum managed node group size." },
            "disk_size": { "type": "integer", "minimum": 1, "description": "Node root volume size in GiB." }
          }
        },
        "addons": {
          "type": "object",
          "description": "EKS add-ons keyed by AWS add-on name.",
          "additionalProperties": {
            "type": "object",
            "required": ["enabled"],
            "additionalProperties": false,
            "properties": {
              "enabled": { "type": "boolean", "description": "Whether this EKS add-on is installed." },
              "version": { "type": "string", "description": "Optional explicit add-on version." }
            }
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "required": ["enabled", "class_name"],
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "description": "Whether Kubernetes ingress is enabled for this component." },
        "class_name": { "type": "string", "minLength": 1, "description": "Ingress class name." }
      }
    },
    "ingressFeature": {
      "type": "object",
      "required": ["enabled", "class_name"],
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "description": "Whether this ingress feature is enabled." },
        "class_name": { "type": "string", "minLength": 1, "description": "Ingress class name." }
      }
    },
    "namedIngressFeature": {
      "type": "object",
      "required": ["enabled", "hostname", "ingress"],
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "description": "Whether this component is deployed." },
        "hostname": { "type": "string", "minLength": 1, "description": "Public hostname for this component." },
        "ingress": { "$ref": "#/$defs/ingress" }
      }
    },
    "headlamp": {
      "type": "object",
      "required": ["enabled", "hostname", "ingress", "cloudflare_tunnel"],
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "description": "Whether Headlamp is deployed." },
        "hostname": { "type": "string", "minLength": 1, "description": "Public Headlamp hostname." },
        "ingress": { "$ref": "#/$defs/ingress" },
        "cloudflare_tunnel": {
          "type": "object",
          "required": ["enabled", "namespace", "release_name", "replica_count", "service", "chart_version", "access"],
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean", "description": "Whether Headlamp access is exposed through Cloudflare Tunnel." },
            "namespace": { "type": "string", "minLength": 1, "description": "Kubernetes namespace for the tunnel." },
            "release_name": { "type": "string", "minLength": 1, "description": "Helm release name for the tunnel." },
            "replica_count": { "type": "integer", "minimum": 1, "description": "Number of tunnel replicas." },
            "service": { "type": "string", "minLength": 1, "description": "Internal Headlamp service URL reached by the tunnel." },
            "chart_version": { "type": "string", "description": "Optional Helm chart version pin." },
            "access": {
              "type": "object",
              "required": ["enabled", "allowed_emails"],
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean", "description": "Whether Cloudflare Access policy is enabled." },
                "allowed_emails": {
                  "type": "array",
                  "description": "Email addresses allowed through Cloudflare Access.",
                  "items": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        }
      }
    },
    "jenkins": {
      "type": "object",
      "required": ["enabled", "hostname", "namespace", "release_name", "repository_url", "branch", "job_name", "cloudflare_tunnel"],
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "description": "Whether Terraform installs Jenkins into EKS." },
        "hostname": { "type": "string", "minLength": 1, "description": "Public Jenkins hostname." },
        "namespace": { "type": "string", "minLength": 1, "description": "Kubernetes namespace for Jenkins." },
        "release_name": { "type": "string", "minLength": 1, "description": "Helm release name for Jenkins." },
        "chart_version": { "type": "string", "description": "Optional Jenkins Helm chart version. Empty means the provider uses the repository default." },
        "controller_tag": { "type": "string", "description": "Jenkins controller image tag." },
        "public_url": { "type": "string", "minLength": 1, "description": "External URL Jenkins advertises for browser access and reverse proxy checks." },
        "storage_class": { "type": "string", "description": "StorageClass used by Jenkins persistent volume claim." },
        "storage_size": { "type": "string", "description": "Persistent volume size for Jenkins home." },
        "repository_url": { "type": "string", "minLength": 1, "description": "Git repository URL used by the seeded Jenkins job." },
        "branch": { "type": "string", "minLength": 1, "description": "Git branch used by the seeded Jenkins job." },
        "job_name": { "type": "string", "minLength": 1, "description": "Seeded Jenkins pipeline job name." },
        "locale": {
          "type": "object",
          "description": "Jenkins locale plugin settings applied through Configuration as Code.",
          "additionalProperties": false,
          "properties": {
            "system_locale": { "type": "string", "minLength": 1, "description": "Default Jenkins locale code, for example 'en'." },
            "ignore_accept_language": { "type": "boolean", "description": "Whether Jenkins ignores browser language preferences and forces the configured locale." },
            "allow_user_preferences": { "type": "boolean", "description": "Whether users may override the global locale in their profile." }
          }
        },
        "theme": {
          "type": "object",
          "description": "Jenkins Theme Manager settings applied through Configuration as Code.",
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string", "minLength": 1, "description": "Theme identifier, for example 'darkSystem' or 'dark' from the Dark Theme plugin." },
            "disable_user_themes": { "type": "boolean", "description": "Whether users are prevented from selecting a different theme." }
          }
        },
        "cloudflare_tunnel": {
          "type": "object",
          "required": ["enabled", "service", "access"],
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean", "description": "Whether Jenkins access is exposed through the shared Cloudflare Tunnel." },
            "service": { "type": "string", "minLength": 1, "description": "Internal Jenkins service URL reached by the tunnel." },
            "access": {
              "type": "object",
              "required": ["enabled", "allowed_emails"],
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean", "description": "Whether Cloudflare Access policy is enabled for Jenkins." },
                "allowed_emails": {
                  "type": "array",
                  "description": "Email addresses allowed through Cloudflare Access.",
                  "items": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        }
      }
    },
    "coinops": {
      "type": "object",
      "required": ["enabled", "hostname", "runtime_backend", "ingress"],
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "description": "Whether Coin-Ops workloads are deployed." },
        "hostname": { "type": "string", "minLength": 1, "description": "Public Coin-Ops hostname." },
        "runtime_backend": { "type": "string", "enum": ["postgres", "external"], "description": "Runtime backend used by Coin-Ops workloads." },
        "ingress": { "$ref": "#/$defs/ingress" }
      }
    },
    "internalTls": {
      "type": "object",
      "required": ["enabled", "port"],
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "description": "Whether internal backend TLS is enabled." },
        "port": { "$ref": "#/$defs/port", "description": "Internal TLS listener port." }
      }
    },
    "cnpgBackup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "description": "Whether CloudNativePG backup support is enabled." },
        "provider": { "type": "string", "enum": ["", "gcs", "s3"], "description": "Backup provider. Empty means derive from secret backend." },
        "bucket_name": { "type": "string", "description": "Optional explicit backup bucket name." },
        "path": { "type": "string", "description": "Backup object path prefix." },
        "retention_days": { "type": "integer", "minimum": 1, "description": "Backup retention in days." },
        "schedule": { "type": "string", "description": "Cron schedule for backups." }
      }
    }
  }
}
